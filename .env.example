# Copy to .env.local and fill in. Never put a real value in this file.
#
# Only NEXT_PUBLIC_* variables reach the browser. The Supabase service-role key
# must never appear here, in .env.local, or anywhere in frontend code.

# ── API ──
# Local backend (wandrly-backend: npm run dev). Needs http://localhost:3000 in
# its CORS_ORIGINS — set that in the backend's own .env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Deployed (Koyeb, fra). Blocked until CORS_ORIGINS there includes
# http://localhost:3000 — see FRONTEND_TECHNICAL_DESIGN.md §17.1.
# NEXT_PUBLIC_API_BASE_URL=https://slimy-selestina-prathameshpatil-a39296fd.koyeb.app
# NEXT_PUBLIC_WS_BASE_URL=wss://slimy-selestina-prathameshpatil-a39296fd.koyeb.app

# ── Auth ──
# The backend verifies Supabase JWTs against this project's JWKS and nothing else.
NEXT_PUBLIC_SUPABASE_URL=https://jwanruyoqxdvakvheqvq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Local development escape hatch ──
# The deployed backend verifies asymmetric Supabase keys, but a local backend with
# SUPABASE_JWT_SECRET set accepts an HS256 token from `npm run token:dev`. Paste one
# here to work against a local API without standing up Supabase auth at all.
# Ignored entirely unless NODE_ENV is development.
# NEXT_PUBLIC_DEV_ACCESS_TOKEN=
